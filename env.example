# ==============================================
# HC ECO SYSTEM - Environment Configuration
# ==============================================
# Rename this file to .env and fill in the values
# NEVER commit the .env file to version control!
# ==============================================

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DB_HOST=localhost
DB_NAME=nangluongmattroi
DB_USER=your_database_username
DB_PASS=your_database_password

# ==============================================
# ORDER NOTIFICATION SETTINGS
# ==============================================
# Email to receive order notifications
ORDER_NOTIFICATION_EMAIL=admin@yourdomain.com

# FormSubmit.co URL for email notifications (optional)
# Get your URL from https://formsubmit.co/
FORMSUBMIT_URL=https://formsubmit.co/your_email@domain.com

# ==============================================
# SITE INFORMATION
# ==============================================
SITE_NAME=HC Eco System
SITE_EMAIL=contact@yourdomain.com
SITE_WEBSITE=yourdomain.com

# ==============================================
# OPTIONAL: ADVANCED SETTINGS
# ==============================================
# Rate limiting (requests per minute)
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW=60

# Debug mode (set to false in production!)
# DEBUG_MODE=false

